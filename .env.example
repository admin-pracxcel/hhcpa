# Contact form → n8n. The URL is not secret, but keeping it server-side keeps it
# out of the client bundle and off the cross-origin surface.
CONTACT_WEBHOOK_URL="https://n8n.pracxcel.com.au/webhook/hhcpa-contact"

# Optional. When set, /api/contact signs the exact request body with
# HMAC-SHA256 and sends it as X-HHCP-Signature, so the n8n workflow can reject
# anything that did not come from this server. Leave unset to send unsigned.
CONTACT_WEBHOOK_SECRET=""
