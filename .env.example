# Set to "true" on the production host only.
#
# Anything else — staging, previews, a laptop — serves `noindex` on every page
# and an empty sitemap, so a copy of the site cannot compete with the real one
# for the terms it was built to win.
#
# Forgetting this on production costs a day of not being indexed, which is
# visible and reversible. Forgetting to exclude a host would not be.
SITE_INDEXABLE=true

# Signs quiz and contact submissions to n8n. Unset means unsigned.
# QUIZ_WEBHOOK_SECRET=

# The discharge letter form has its own n8n workflow:
# https://n8n.pracxcel.com.au/webhook/hhcpa-discharge
#
# It posts through /api/quiz, which is where the retry, idempotency key and
# fallback live, but it is forwarded to its own destination from there.
#
# ⚠️ Its payload carries countsTowardPatientQuota: true. A discharge request
# is its own enquiry under Clause 1.2 and has always counted, so the discharge
# workflow has to count it — otherwise splitting it out of the quiz workflow
# quietly drops every transfer request from the monthly number.
#
# Override for local testing only.
# DISCHARGE_WEBHOOK_URL=
# DISCHARGE_WEBHOOK_SECRET=

# Newsletter signups go to https://n8n.pracxcel.com.au/webhook/hhcpa-newsletter
# by default. Override for local testing only — every route that takes an
# override logs a warning at boot, because a stale one swallows real signups
# while the form still tells the visitor it worked.
# NEWSLETTER_WEBHOOK_URL=
# NEWSLETTER_WEBHOOK_SECRET=
